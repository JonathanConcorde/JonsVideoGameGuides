---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const guides=(await getCollection('guides')).sort((a,b)=>b.data.updated.valueOf()-a.data.updated.valueOf());
const featured=guides.filter(g=>g.data.featured).slice(0,6);
const games=[
 {name:'Diablo IV',slug:'diablo-4',tag:'Seasonal ARPG',mark:'D4',description:'Warlock builds, leveling, endgame farming, gear priorities, rotations, and inventory decisions.'},
 {name:'Valheim',slug:'valheim',tag:'Survival',mark:'V',description:'Biome-by-biome progression, base planning, bosses, gear, exploration, and preparation.'},
 {name:'Voidpet',slug:'voidpet',tag:'Boss Progression',mark:'VP',description:'Stage-specific teams, pet investment priorities, equipment choices, and boss mechanics.'},
 {name:'Palworld',slug:'palworld',tag:'Creature Survival',mark:'PW',description:'Base automation, breeding, combat Pals, mounts, and long-term progression.'},
 {name:'ARK: Survival Ascended',slug:'ark-asa',tag:'Survival',mark:'ARK',description:'Single-player PvE progression, taming, equipment, bases, and boss preparation.'},
 {name:'Starfield',slug:'starfield',tag:'RPG / Outposts',mark:'SF',description:'NG+ progression, linked outposts, manufacturing chains, XP, and credits.'},
 {name:'Grounded',slug:'grounded',tag:'Survival',mark:'G',description:'Laboratory progression, equipment, preparation, exploration, and base efficiency.'},
 {name:'Cyberpunk 2077',slug:'cyberpunk-2077',tag:'Action RPG',mark:'CP',description:'Katana and Sandevistan progression, cyberware, mobility, and combat flow.'},
 {name:'7 Days to Die',slug:'7-days-to-die',tag:'Survival',mark:'7D',description:'Navezgane base planning, early progression, crafting, looting, and horde prep.'},
 {name:"Assassin's Creed IV: Black Flag",slug:'ac-black-flag',tag:'Action Adventure',mark:'AC',description:'Jackdaw upgrades, side-content priorities, resources, and efficient story progression.'}
];
---
<BaseLayout>
<section class="hero hero-home"><div class="container hero-grid">
<div>
<div class="kicker">Personal Strategy Library</div>
<h1>Less searching.<br/><span class="gradient-text">More playing.</span></h1>
<p class="hero-copy">The builds, progression routes, farming priorities, boss plans, and reference notes I actually use—organized for fast answers in the middle of a game.</p>
<div class="hero-actions"><a class="button primary" href="/guides/">Browse all guides</a><a class="button secondary" href="#games">Choose a game</a></div>
<div class="stat-row"><div><strong>{games.length}</strong><span>Games covered</span></div><div><strong>{guides.length}</strong><span>Published guides</span></div><div><strong>1</strong><span>Game in development</span></div></div>
</div>
<div class="hero-panel">
<div class="panel-label">CURRENT FOCUS</div>
<div class="focus-item"><span class="focus-mark">D4</span><div><strong>Diablo IV</strong><small>Season 15 · Warlock</small></div></div>
<div class="focus-item"><span class="focus-mark valheim">V</span><div><strong>Valheim</strong><small>Progression playthrough</small></div></div>
<div class="focus-item"><span class="focus-mark voidpet">VP</span><div><strong>Voidpet</strong><small>Stage & boss planning</small></div></div>
<div class="panel-rule"></div>
<a class="focus-item evolution-focus" href="/evolution/"><span class="focus-mark evolution">E</span><div><strong>Evolution</strong><small>Game in development →</small></div></a>
</div>
</div></section>
<section class="section" id="games"><div class="container">
<div class="section-heading"><div><div class="kicker">Library</div><h2>Games I play</h2></div><a class="text-link" href="/guides/">View every guide →</a></div>
<div class="game-grid">
{games.map(game=>{const count=guides.filter(g=>g.data.gameSlug===game.slug).length;return <a class={'game-card game-'+game.slug} href={'/games/'+game.slug+'/'}>
<div class="game-top"><span class="game-mark">{game.mark}</span><span class="game-tag">{game.tag}</span></div>
<div><h3>{game.name}</h3><p>{game.description}</p></div>
<div class="game-footer"><span>{count} {count===1?'guide':'guides'}</span><span>Open hub →</span></div>
</a>})}
</div>
</div></section>
<section class="section alt-section"><div class="container">
<div class="section-heading"><div><div class="kicker">Start here</div><h2>Featured guides</h2></div></div>
<div class="featured-grid">
{featured.map(guide=><a class="featured-card" href={'/guides/'+guide.id.replace(/\.(md|mdx)$/,'')+'/'}>
<span class="eyebrow">{guide.data.game} · {guide.data.category}</span><h3>{guide.data.title}</h3><p>{guide.data.description}</p>
<div class="featured-meta"><span class={'status status-'+guide.data.status.toLowerCase().replace(' ','-')}>{guide.data.status}</span><span>Updated {guide.data.updated.toLocaleDateString('en-US',{month:'short',day:'numeric'})}</span></div>
</a>)}
</div>
</div></section>
<section class="section"><div class="container evolution-banner"><div><div class="kicker">Games I make</div><h2>Evolution</h2><p>A biologically grounded, turn-based evolution RPG in active development. The site is structured so the game, player guide, changelog, and development notes can all live together later.</p></div><a class="button primary" href="/evolution/">Visit Evolution hub</a></div></section>
</BaseLayout>