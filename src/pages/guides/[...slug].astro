---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){
 const guides = await getCollection('guides');
 return guides.map(guide=>({params:{slug:guide.id.replace(/\.(md|mdx)$/,'')},props:{guide}}));
}
const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const allGuides = await getCollection('guides');
const related = allGuides.filter(g=>g.data.gameSlug===guide.data.gameSlug && g.id!==guide.id).sort((a,b)=>a.data.order-b.data.order).slice(0,3);
---
<BaseLayout title={guide.data.title + " | Jon's Game Guides"} description={guide.data.description}>
<section class="guide-header"><div class="container">
<a class="back-link" href={'/games/'+guide.data.gameSlug+'/'}>← {guide.data.game} hub</a>
<div class="kicker">{guide.data.game} · {guide.data.category}</div>
<h1>{guide.data.title}</h1>
<p class="guide-dek">{guide.data.description}</p>
<div class="guide-header-meta"><span class={'status status-'+guide.data.status.toLowerCase().replace(' ','-')}>{guide.data.status}</span><span>Updated {guide.data.updated.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}</span></div>
</div></section>
<div class="container guide">
<article class="guide-content">
<Content />
{related.length>0 && <section class="related-guides"><div class="kicker">Keep going</div><h2>Related {guide.data.game} guides</h2><div class="mini-grid">{related.map(item=><a class="mini-card" href={'/guides/'+item.id.replace(/\.(md|mdx)$/,'')+'/'}>
<span>{item.data.category}</span><strong>{item.data.title}</strong></a>)}</div></section>}
</article>
<aside class="sidebar">
<div class="sidebar-title">GUIDE INFO</div>
<div><small>Game</small>{guide.data.game}</div>
<div><small>Category</small>{guide.data.category}</div>
<div><small>Status</small>{guide.data.status}</div>
<div><small>Last Updated</small>{guide.data.updated.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</div>
{headings.length>0 && <><div class="sidebar-title toc-title">ON THIS PAGE</div><nav class="toc">{headings.filter(h=>h.depth===2).map(h=><a href={'#'+h.slug}>{h.text}</a>)}</nav></>}
</aside>
</div>
</BaseLayout>