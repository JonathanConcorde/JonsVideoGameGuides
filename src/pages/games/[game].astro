---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const gameMeta = {
 'diablo-4':{label:'SEASON 15 ONLY',intro:'This hub is intentionally limited to Diablo IV Season 15. Current focus: Warlock progression and the Blazing Scream endgame build.',mark:'S15'},
 'valheim':{label:'Survival Progression',intro:'A practical roadmap for base building, biomes, bosses, gear, food, exploration, and safe expansion.',mark:'V'},
 'voidpet':{label:'Boss Progression',intro:'Stage-specific teams, pet investment, equipment, elemental matchups, and boss mechanics.',mark:'VP'},
 'palworld':{label:'Creature Survival',intro:'Base automation, breeding, useful Pals, mounts, combat progression, and endgame organization.',mark:'PW'},
 'ark-asa':{label:'Survival Progression',intro:'Single-player PvE planning for taming, equipment, bases, resource routes, breeding, and boss preparation.',mark:'ARK'},
 'starfield':{label:'RPG / Outposts',intro:'NG+ progression, resource networks, linked outposts, manufacturing chains, XP, and credits.',mark:'SF'},
 'grounded':{label:'Survival Progression',intro:'A practical route through equipment, laboratories, preparation, exploration, and base upgrades.',mark:'G'},
 'cyberpunk-2077':{label:'Build Progression',intro:'Katana and Sandevistan progression focused on blades, mobility, cyberware, survivability, and encounter control.',mark:'CP'},
 '7-days-to-die':{label:'Survival Progression',intro:'Navezgane planning for bases, looting, crafting, transportation, and early Blood Moon survival.',mark:'7D'},
 'ac-black-flag':{label:'Action Adventure',intro:'Jackdaw upgrades, side-content priorities, resource efficiency, and a clean route through the main story.',mark:'AC'}
};

const diabloChecklist = [
  { id:'elegy', label:'Elegy', group:'Core Equipment', href:'/guides/diablo-4-blazing-scream/#equipment', note:'Core Blazing Scream setup', priority:1 },
  { id:'infernal-homunculus', label:'Infernal Homunculus', group:'Core Equipment', href:'/guides/diablo-4-blazing-scream/#equipment', note:'Build equipment target', priority:2 },
  { id:'eightfold-idol', label:'Eightfold Idol', group:'Core Equipment', href:'/guides/diablo-4-blazing-scream/#equipment', note:'Build equipment target', priority:3 },
  { id:'temerity', label:'Temerity', group:'Core Equipment', href:'/guides/diablo-4-blazing-scream/#equipment', note:'Build equipment target', priority:4 },
  { id:'molochs-beating-flame', label:"Moloch's Beating Flame", group:'Core Equipment', href:'/guides/diablo-4-blazing-scream/#equipment', note:'Build equipment target', priority:5 },
  { id:'hand-of-apotheosis', label:'Hand of Apotheosis', group:'Core Equipment', href:'/guides/diablo-4-blazing-scream/#equipment', note:'Build equipment target', priority:6 },
  { id:'leorics-crown', label:"Leoric's Crown", group:'Core Equipment', href:'/guides/diablo-4-blazing-scream/#equipment', note:'Build equipment target', priority:7 },
  { id:'stone-of-jordan', label:'Stone of Jordan', group:'Core Equipment', href:'/guides/diablo-4-blazing-scream/#equipment', note:'Build equipment target', priority:8 },
  { id:'enigma', label:'Enigma', group:'Core Equipment', href:'/guides/diablo-4-blazing-scream/#equipment', note:'Runeword target', priority:9 },
  { id:'glyph-eldritch-sight', label:'Eldritch Sight leveled', group:'Glyphs', href:'/guides/diablo-4-blazing-scream/#glyphs', note:'First glyph priority', priority:10 },
  { id:'glyph-demonologist', label:'Demonologist leveled', group:'Glyphs', href:'/guides/diablo-4-blazing-scream/#glyphs', note:'Second glyph priority', priority:11 },
  { id:'glyph-unbound', label:'Unbound leveled', group:'Glyphs', href:'/guides/diablo-4-blazing-scream/#glyphs', note:'Third glyph priority', priority:12 },
  { id:'glyph-hellforge', label:'Hellforge leveled', group:'Glyphs', href:'/guides/diablo-4-blazing-scream/#glyphs', note:'Fourth glyph priority', priority:13 },
  { id:'glyph-attrition', label:'Attrition leveled', group:'Glyphs', href:'/guides/diablo-4-blazing-scream/#glyphs', note:'Fifth glyph priority', priority:14 },
  { id:'gems', label:'Correct gems installed', group:'Build Setup', href:'/guides/diablo-4-blazing-scream/#gems', note:'Ruby weapon/jewelry; Sapphire armor', priority:15 },
  { id:'rotation', label:'Rotation feels reliable', group:'Build Setup', href:'/guides/diablo-4-blazing-scream/#rotation', note:'Metamorphosis → Dark Prison → Sigil → Blazing Scream', priority:16 },
  { id:'masterwork', label:'Core permanent pieces masterworked', group:'Optimization', href:'/guides/diablo-4-blazing-scream/#masterworking', note:'Only after stable gear', priority:17 }
];

export async function getStaticPaths(){
 const guides=await getCollection('guides');
 const slugs=[...new Set(guides.map(g=>g.data.gameSlug))];
 return slugs.map(game=>({params:{game}}));
}

const {game}=Astro.params;
const guides=(await getCollection('guides')).filter(g=>g.data.gameSlug===game).sort((a,b)=>a.data.order-b.data.order);
const gameName=guides[0]?.data.game??game;
const categories=[...new Set(guides.map(g=>g.data.category))];
const meta=gameMeta[game]??{label:'Game Hub',intro:'Guides, progression notes, and reference material.',mark:'GG'};
const isDiablo=game==='diablo-4';
---
<BaseLayout title={gameName+" | Jon's Game Guides"}>
<section class="game-hero"><div class="container game-hero-grid">
<div class={"game-hero-mark "+(isDiablo?'season-mark':'')}>{meta.mark}</div>
<div>
  <div class="kicker">{meta.label}</div>
  <h1>{gameName}</h1>
  <p>{meta.intro}</p>
  {isDiablo && <div class="season-lock"><strong>Season 15 scope:</strong> No Season 14 or earlier builds are being maintained here right now.</div>}
  <div class="hero-actions"><a class="button primary" href={isDiablo?'#progress':'#guides'}>{isDiablo?'Open my S15 tracker':'Browse '+guides.length+' guides'}</a><a class="button secondary" href="/guides/">All games</a></div>
</div>
</div></section>

{isDiablo && <section class="section tracker-section" id="progress"><div class="container">
  <div class="section-heading"><div><div class="kicker">Season 15 progress</div><h2>What should I do next?</h2><p class="section-copy">Check off what you already have. Your progress is saved on this device, and the next incomplete priority is surfaced automatically.</p></div></div>
  <div class="tracker-summary">
    <div><span class="tracker-label">NEXT PRIORITY</span><strong id="next-task">Loading your checklist…</strong><a id="next-task-link" class="text-link" href="/guides/diablo-4-blazing-scream/#equipment">Open the relevant guide section →</a></div>
    <div class="tracker-progress"><span id="progress-count">0 / 17</span><div class="progress-bar"><span id="progress-fill"></span></div></div>
  </div>
  <div class="checklist-grid">
    {['Core Equipment','Glyphs','Build Setup','Optimization'].map(group=><div class="checklist-card">
      <div class="checklist-card-title">{group}</div>
      {diabloChecklist.filter(item=>item.group===group).map(item=><label class="checklist-item" data-priority={item.priority}>
        <input type="checkbox" data-check-id={item.id} data-label={item.label} data-href={item.href} />
        <span class="checkmark"></span>
        <span class="check-copy"><strong>{item.label}</strong><small>{item.note}</small></span>
        <a class="check-guide-link" href={item.href} aria-label={'Open guide section for '+item.label}>Guide →</a>
      </label>)}
    </div>)}
  </div>
  <div class="tracker-actions"><button id="reset-progress" class="button secondary" type="button">Reset Season 15 checklist</button></div>
</div></section>}

<div id="guides">{categories.map(category=><section class="section"><div class="container"><div class="section-heading"><div><div class="kicker">{isDiablo?'Season 15 guide category':'Guide category'}</div><h2>{category}</h2></div></div><div class="guide-list">{guides.filter(g=>g.data.category===category).map((guide,index)=><a class="guide-row" href={'/guides/'+guide.id.replace(/\.(md|mdx)$/,'')+'/'}><span class="guide-number">{String(index+1).padStart(2,'0')}</span><div class="guide-row-copy"><strong>{guide.data.title}</strong><span>{guide.data.description}</span></div><div class="guide-row-meta">{isDiablo && <span class="season-chip">S15</span>}<span class={'status status-'+guide.data.status.toLowerCase().replace(' ','-')}>{guide.data.status}</span><span>→</span></div></a>)}</div></div></section>)}</div>

{isDiablo && <script is:inline>
(() => {
  const storageKey='jons-guides-diablo4-s15-progress-v1';
  const boxes=[...document.querySelectorAll('[data-check-id]')];
  const nextTask=document.getElementById('next-task');
  const nextLink=document.getElementById('next-task-link');
  const count=document.getElementById('progress-count');
  const fill=document.getElementById('progress-fill');
  const reset=document.getElementById('reset-progress');
  let saved={};
  try { saved=JSON.parse(localStorage.getItem(storageKey)||'{}'); } catch(e) { saved={}; }

  function render(){
    boxes.forEach(box=>{ box.checked=Boolean(saved[box.dataset.checkId]); });
    const completed=boxes.filter(box=>box.checked).length;
    count.textContent=completed+' / '+boxes.length;
    fill.style.width=(boxes.length ? (completed/boxes.length)*100 : 0)+'%';
    const next=boxes.filter(box=>!box.checked).sort((a,b)=>Number(a.closest('[data-priority]').dataset.priority)-Number(b.closest('[data-priority]').dataset.priority))[0];
    if(next){
      nextTask.textContent=next.dataset.label;
      nextLink.href=next.dataset.href;
      nextLink.textContent='Open '+next.dataset.label+' guide section →';
    }else{
      nextTask.textContent='Season 15 checklist complete';
      nextLink.href='/guides/diablo-4-blazing-scream/#masterworking';
      nextLink.textContent='Review optimization and masterworking →';
    }
  }

  boxes.forEach(box=>box.addEventListener('change',()=>{
    saved[box.dataset.checkId]=box.checked;
    localStorage.setItem(storageKey,JSON.stringify(saved));
    render();
  }));

  reset.addEventListener('click',()=>{
    saved={};
    localStorage.removeItem(storageKey);
    render();
  });

  render();
})();
</script>}
</BaseLayout>